<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Add Toolbar for navigation -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.MaterialComponents.Toolbar.Primary"
        app:title="Register Person"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <!-- Camera and overlay content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top UI Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#90000000">

            <TextView
                android:id="@+id/instructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Enter your details and look at the camera"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:background="#802196F3"
                android:padding="8dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/faceStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👤 Position your face in camera view"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:background="#80666666"
                android:padding="6dp"
                android:layout_marginTop="4dp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Bottom Form Panel -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#90000000"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@android:color/white"
                    app:hintTextColor="@android:color/white"
                    app:boxStrokeColor="@android:color/white"
                    app:boxStrokeWidthFocused="2dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        android:textColor="@android:color/white"
                        android:textColorHint="#CCFFFFFF"
                        android:inputType="textPersonName"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColorHint="@android:color/white"
                    app:hintTextColor="@android:color/white"
                    app:boxStrokeColor="@android:color/white"
                    app:boxStrokeWidthFocused="2dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/employeeIdEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Employee ID"
                        android:textColor="@android:color/white"
                        android:textColorHint="#CCFFFFFF"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/captureButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CAPTURE FACE"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#1976D2"
                        style="@style/Widget.MaterialComponents.Button"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:enabled="false"
                        app:icon="@drawable/ic_camera"
                        app:iconPadding="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/registerButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="REGISTER"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#2E7D32"
                        style="@style/Widget.MaterialComponents.Button"
                        android:padding="12dp"
                        android:layout_marginStart="8dp"
                        android:enabled="false"
                        app:icon="@drawable/ic_check"
                        app:iconPadding="8dp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</LinearLayout>